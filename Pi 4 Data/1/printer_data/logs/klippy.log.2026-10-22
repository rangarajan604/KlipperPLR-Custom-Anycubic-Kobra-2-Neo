shaper_freq_x = 64.6
shaper_type_y = mzv
shaper_freq_y = 43.4

[stepper_x]
step_pin = PA12
dir_pin = PA11
enable_pin = !PA15
microsteps = 16
rotation_distance = 40
endstop_pin = ^!PB11
position_endstop = -10
position_min = -14
position_max = 235
homing_speed = 100

[stepper_y]
