dir_pin = !PB1
enable_pin = !PA15
microsteps = 16
rotation_distance = 8
endstop_pin = probe:z_virtual_endstop
position_min = -5
position_max = 250
homing_speed = 3
homing_retract_dist = 5
second_homing_speed = 1

[extruder]
