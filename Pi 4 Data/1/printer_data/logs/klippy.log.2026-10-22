x_offset = 24.0
y_offset = 13.35
samples = 3
samples_result = average
samples_tolerance = 0.050
samples_tolerance_retries = 2
sample_retract_dist = 5
speed = 3
lift_speed = 5
z_offset = 2.390

[bed_mesh]
speed = 50
horizontal_move_z = 5
mesh_min = 14, 11
mesh_max = 210, 215
probe_count = 8,8
mesh_pps = 6,6
algorithm = bicubic
bicubic_tension = 0.2

[safe_z_home]
