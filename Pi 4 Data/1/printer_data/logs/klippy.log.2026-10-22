sensor_type = ATC Semitec 104GT-2
sensor_pin = PC3
min_extrude_temp = 170
min_temp = 0
max_temp = 270
control = pid
pid_kp = 22.131
pid_ki = 1.032
pid_kd = 118.675

[heater_bed]
