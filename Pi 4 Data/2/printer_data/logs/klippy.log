	SET_VELOCITY_LIMIT ACCEL={printer.configfile.settings.printer.max_accel}

[gcode_macro PID_BED_55]
gcode = 
	
	PID_CALIBRATE HEATER=heater_bed TARGET=55
	
	SAVE_CONFIG

[gcode_macro PID_EXTRUDER_195]
gcode = 
	
	G90
	G28
	G1 X2 Y-2
	
	
	M140 S55
	
	M190 S55
	
	PID_CALIBRATE HEATER=extruder TARGET=195
	
	SAVE_CONFIG

[gcode_macro T1]
gcode = 
	{% set X = params.X|default(50)|float %}
	{% set Y = params.Y|default(0)|float %}
	{% set Z = params.Z|default(10)|float %}
	SAVE_GCODE_STATE NAME=T1_state
	PAUSE
	G91
	G1 E-.5 F2700
	G1 Z{Z}
	G90
	G1 X{X} Y{Y} F3000
	G91
	PULL_FILAMENT_OUT
	
	beeper I=5 P=1000
	RESTORE_GCODE_STATE NAME=T1_state

[exclude_object]

[gcode_arcs]

[mcu]
serial = /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0

[printer]
kinematics = cartesian
max_velocity = 300
max_accel = 10000
max_z_velocity = 8
max_z_accel = 800

[input_shaper]
shaper_freq_x = 54.8
shaper_type_x = ei
shaper_freq_y = 34.0
shaper_type_y = mzv

[stepper_x]
step_pin = PA12
dir_pin = PA11
enable_pin = !PA15
microsteps = 16
rotation_distance = 40
endstop_pin = ^!PB11
position_endstop = -10
position_min = -14
position_max = 235
homing_speed = 100

[stepper_y]
step_pin = PA9
dir_pin = !PA8
enable_pin = !PA15
microsteps = 16
rotation_distance = 40
endstop_pin = ^!PC13
position_endstop = -2
position_min = -3
position_max = 240
homing_speed = 100

[stepper_z]
step_pin = PB0
dir_pin = !PB1
enable_pin = !PA15
microsteps = 16
rotation_distance = 8
endstop_pin = probe:z_virtual_endstop
position_min = -5
position_max = 250
homing_speed = 5
homing_retract_dist = 5
second_homing_speed = 2

[extruder]
max_extrude_cross_section = 5.0
step_pin = PB15
dir_pin = PB14
enable_pin = !PA15
microsteps = 16
max_extrude_only_distance = 200
max_extrude_only_velocity = 80
max_extrude_only_accel = 5000
rotation_distance = 7.084
nozzle_diameter = 0.400
filament_diameter = 1.750
pressure_advance = 0.0400
heater_pin = PB8
sensor_type = ATC Semitec 104GT-2
sensor_pin = PC3
min_extrude_temp = 170
min_temp = 0
max_temp = 280
control = pid
pid_ki = 0.88
pid_kd = 59.12
pid_kp = 14.42

[heater_bed]
heater_pin = PB9
sensor_type = EPCOS 100K B57560G104F
sensor_pin = PC1
min_temp = 0
max_temp = 120
control = pid
pid_kp = 97.1
pid_ki = 1.41
pid_kd = 1675.16

[probe]
pin = PA1
x_offset = 24.0
y_offset = 13.35
samples = 6
samples_result = average
samples_tolerance = 0.100
samples_tolerance_retries = 2
sample_retract_dist = 5
speed = 4
lift_speed = 5
z_offset = 3.480

[bed_mesh]
speed = 50
horizontal_move_z = 5
mesh_min = 14, 11
mesh_max = 210, 215
probe_count = 6,6
mesh_pps = 6,6
algorithm = bicubic
bicubic_tension = 0.2

[safe_z_home]
home_xy_position = 110, 110
speed = 50
z_hop = 5
z_hop_speed = 10

[controller_fan controller_fan]
pin = PB12

[heater_fan extruder_fan]
pin = PB13

[fan]
pin = PB5
cycle_time = 0.00005

[output_pin enable_pin]
pin = PB6
value = 1

[gcode_button pb4]
pin = PB4
press_gcode = CANCEL_PRINT

[gcode_button pa0]
pin = PA0
press_gcode = 
	QUERY_BUTTON button=pa0
release_gcode = 
	QUERY_BUTTON button=pa0

[temperature_sensor raspberry_pi]
sensor_type = temperature_host
min_temp = 10
max_temp = 100

[temperature_sensor mcu_temp]
sensor_type = temperature_mcu
min_temp = 0
max_temp = 100

[save_variables]
filename = ~/printer_data/config/variables.cfg

[bed_mesh default]
version = 1
points = 
	-0.132500, -0.030000, 0.002500, 0.025000, 0.021250, 0.003750
